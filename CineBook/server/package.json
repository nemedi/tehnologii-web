{
  "name": "cinema-reservation",
  "version": "1.0.0",
  "description": "Cinema seat reservation web application",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "concurrently \"node --watch index.js\" \"npm run dev --prefix ../client\"",
    "install-all": "npm install && npm install --prefix ../client",
    "build": "npm run build --prefix ../client"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-sqlite3": "^0.9.16",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
